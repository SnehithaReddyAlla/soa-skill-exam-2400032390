    // =========================================================
    // TEST CASE 4
    // LOAD BALANCING CHECK
    //
    // Multiple TaskService instances are required.
    //
    // Expected to fail because Eureka and LoadBalancer
    // are not configured.
    // =========================================================

    @Test
    void testLoadBalancing() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 4 : LOAD BALANCING CHECK");
        System.out.println("==========================================");

        for (int i = 1; i <= 10; i++) {

            MvcResult result =
                    mockMvc.perform(
                            get("/task/displayall")
                    )
                    .andReturn();

            String response =
                    result.getResponse().getContentAsString();

            System.out.println();
            System.out.println("Request " + i);

            System.out.println(
                    "Status : "
                    + result.getResponse().getStatus()
            );

            System.out.println("Response : " + response);
        }

        fail(
                "Load balancing cannot be verified because "
                + "Eureka and multiple service instances are not configured"
        );
    }


