    }


    // =========================================================
    // TEST CASE 8
    // TASK RETRIEVAL
    // =========================================================

    @Test
    void testTaskRetrieval() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 8 : TASK RETRIEVAL");
        System.out.println("==========================================");

        String request =
                getTaskRequest(
                        "Retrieval Test Task",
                        "Testing",
                        "Pending",
                        "Vijayawada"
                );

        MvcResult createResult =
                mockMvc.perform(
                        post("/task/add")
                                .contentType(MediaType.APPLICATION_JSON)
                                .content(request)
                )
                .andExpect(status().isCreated())
                .andReturn();

        String response =
                createResult.getResponse().getContentAsString();

        Long id =
                objectMapper.readTree(response)
                        .get("id")
                        .asLong();

        MvcResult result =
                mockMvc.perform(
                        get("/task/display/" + id)
                )
                .andExpect(status().isOk())
                .andReturn();

        String taskResponse =
                result.getResponse().getContentAsString();

        System.out.println("Task ID : " + id);
        System.out.println("Response : " + taskResponse);

        assertTrue(
                taskResponse.contains("Retrieval Test Task")
        );

        System.out.println("TC-8 PASSED : TASK RETRIEVED");
    }


    // =========================================================
    // TEST CASE 9
    // TASK UPDATE
    // =========================================================

    @Test
    void testTaskUpdate() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 9 : TASK UPDATE");
        System.out.println("==========================================");

        String request =
                getTaskRequest(
                        "Update Test Task",
                        "Testing",
                        "Pending",
                        "Vijayawada"
                );

        MvcResult createResult =
                mockMvc.perform(
                        post("/task/add")
                                .contentType(MediaType.APPLICATION_JSON)
                                .content(request)
                )
                .andExpect(status().isCreated())
                .andReturn();

        Long id =
                objectMapper.readTree(
                        createResult.getResponse().getContentAsString()
                ).get("id").asLong();

        String updateRequest =
                getTaskRequest(
                        "Updated Task",
                        "Development",
                        "Completed",
                        "Hyderabad"
                );

        MvcResult result =
                mockMvc.perform(
                        put("/task/update/" + id)
                                .contentType(MediaType.APPLICATION_JSON)
                                .content(updateRequest)
                )
                .andExpect(status().isOk())
                .andReturn();

        String response =
                result.getResponse().getContentAsString();

        System.out.println("Response : " + response);

        assertTrue(response.contains("Updated Task"));

        System.out.println("TC-9 PASSED : TASK UPDATED");
    }


