    @Test
    void testTaskCreation() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 7 : TASK CREATION");
        System.out.println("==========================================");

        String request =
                getTaskRequest(
                        "Integration Test Task",
                        "Testing",
                        "Pending",
                        "Vijayawada"
                );

        MvcResult result =
                mockMvc.perform(
                        post("/task/add")
                                .contentType(MediaType.APPLICATION_JSON)
