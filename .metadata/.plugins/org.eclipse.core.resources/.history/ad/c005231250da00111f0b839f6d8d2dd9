    // =========================================================
    // COMMON METHOD
    // CREATE TASK REQUEST
    // =========================================================

    private String getTaskRequest(
            String name,
            String type,
            String status,
            String location) throws Exception {

        return "{"
                + "\"name\":\"" + name + "\","
                + "\"type\":\"" + type + "\","
                + "\"status\":\"" + status + "\","
                + "\"location\":\"" + location + "\""
                + "}";
    }


    // =========================================================
    // TEST CASE 1
    // VALID WORKFLOW
    //
    // Login -> JWT -> Protected API -> Success
    //
    // Expected to fail because JWT is not configured.
    // =========================================================

    @Test
    void testValidWorkflow() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 1 : VALID WORKFLOW");
        System.out.println("==========================================");

        String loginRequest =
                "{"
                + "\"username\":\"admin\","
                + "\"password\":\"admin\""
                + "}";

        MvcResult result =
                mockMvc.perform(
                        post("/task/login")
                                .contentType(MediaType.APPLICATION_JSON)
                                .content(loginRequest)
                )
                .andReturn();

        int status =
                result.getResponse().getStatus();

        String response =
                result.getResponse().getContentAsString();

        System.out.println("Status Code : " + status);
        System.out.println("Response : " + response);

        assertEquals(
                200,
                status,
                "Task Service does not currently implement JWT login"
        );

        System.out.println("TC-1 PASSED");
    }


    // =========================================================
    // TEST CASE 2
    // INVALID JWT
    //
    // Expected : 401 Unauthorized
    // Expected to fail because JWT security is not configured.
    // =========================================================

    @Test
    void testInvalidJWT() throws Exception {

        System.out.println();
        System.out.println("==========================================");
        System.out.println("TEST CASE 2 : INVALID JWT");
        System.out.println("==========================================");

        String invalidToken =
                "invalid-jwt-token";

        MvcResult result =
                mockMvc.perform(
                        get("/task/displayall")
                                .header(
                                        "Authorization",
                                        "Bearer " + invalidToken
                                )
                )
                .andReturn();

        int status =
                result.getResponse().getStatus();

        String response =
                result.getResponse().getContentAsString();

        System.out.println("Status Code : " + status);
        System.out.println("Response : " + response);

        assertEquals(
                401,
                status,
                "JWT security is not configured in Task Service"
        );

        System.out.println("TC-2 PASSED : INVALID JWT -> 401");
    }


